{
  "name": "bwebbie187stealthagent",
  "version": "1.0.0",
  "private": true,
  "description": "A minimal on-chain signal contract deployable to Base and GOAT Network.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:base-sepolia": "hardhat run scripts/deploy.js --network baseSepolia",
