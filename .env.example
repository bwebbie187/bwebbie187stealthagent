# Copy this file to .env and set the deployer's private key locally.
# Never commit .env or share the private key.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Optional RPC overrides. Defaults are public endpoints (may be rate limited).
BASE_RPC=https://mainnet.base.org
BASE_SEPOLIA_RPC=https://sepolia.base.org
GOAT_RPC=https://rpc.goat.network
GOAT_TESTNET_RPC=https://rpc.testnet3.goat.network

# Set to 1 only when intentionally deploying to Base or GOAT mainnet.
# DEPLOY_CONFIRM_MAINNET=1
